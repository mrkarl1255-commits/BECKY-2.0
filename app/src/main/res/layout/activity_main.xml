<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/becky_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        style="@style/BeckyText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_title" />

    <TextView
        android:id="@+id/subtitleText"
        style="@style/BeckyText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/main_subtitle" />

    <TextView
        android:id="@+id/statusText"
        style="@style/BeckyText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/status_waiting" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScan"
        style="@style/BeckyButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/btn_scan" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDevices"
        style="@style/BeckyButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_devices" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnection"
        style="@style/BeckyButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_connection" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDiagnostics"
        style="@style/BeckyButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_diagnostics" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogs"
        style="@style/BeckyButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_logs" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoice"
        style="@style/BeckyButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_voice" />

</LinearLayout>
